# Релиз iOS в TestFlight: скопируй в .env.ios-release.local (gitignored по маске
# .env.*.local) и заполни. Читает scripts/ios/release.sh (npm run ios:release).
#
# Команда разработчика (Team ID). На машине владельца платная команда — G2AA82378K
# (Developer ID выдаётся только платной программе); при ошибке provisioning
# попробуй вторую identity — 2GJM94F693.
IOS_TEAM_ID=G2AA82378K

# Ключ App Store Connect API (Users and Access → Integrations → App Store Connect
# API → Team Keys, роль App Manager). .p8 скачивается один раз.
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
ASC_KEY_PATH=/Users/<you>/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8

# ПРОД-деплой Convex (публичный — он же в бандле сайта). Не dev!
VITE_CONVEX_URL=https://harmless-seahorse-836.convex.cloud
