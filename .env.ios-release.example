# Релиз iOS в TestFlight: скопируй в .env.ios-release.local (gitignored по маске
# .env.*.local) и заполни. Читает scripts/ios/release.sh (npm run ios:release) —
# построчно KEY=VALUE, файл НЕ исполняется как shell; кавычки вокруг значения
# снимаются, ведущий ~/ раскрывается в домашний каталог. Прод-URL Convex здесь
# не нужен — он в коммитнутом .env.ios-release.
#
# Команда разработчика (Team ID, 10 символов A–Z/0–9). На машине владельца
# платная команда — G2AA82378K (Developer ID выдаётся только платной программе);
# при ошибке provisioning попробуй вторую identity — 2GJM94F693.
IOS_TEAM_ID=G2AA82378K

# Ключ App Store Connect API (Users and Access → Integrations → App Store Connect
# API → Team Keys, роль App Manager). .p8 скачивается один раз.
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
ASC_KEY_PATH=~/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8
