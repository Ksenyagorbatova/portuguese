#!/bin/sh
# Pre-push quality gate — nothing leaves the machine until it's green.
#
# Runs `npm run verify` = typecheck + lint + Vitest (unit + backend) +
# Playwright CT. A non-zero exit aborts the push.
#
# Auto-installed by `npm install` (package.json "prepare" sets
# core.hooksPath=.githooks). Emergency bypass (use sparingly): git push --no-verify
echo "▶ pre-push: verifying (typecheck + lint + tests + component tests)…"
npm run verify
