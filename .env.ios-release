# Прод-деплой Convex для релизной iOS-сборки (vite --mode ios-release). Не
# секрет: тот же URL уже в бандле сайта на GitHub Pages. scripts/ios/release.sh
# экспортирует его в окружение сборки — это сильнее любых .env*-файлов (в т.ч.
# dev-URL из .env.local) — и проверяет, что в бандл попал именно он.
VITE_CONVEX_URL=https://harmless-seahorse-836.convex.cloud
